# ============================================================
#  Configuracion del SRB. Cada maquina tiene su propia copia.
#  En un solo computador: las tres IP en 127.0.0.1
# ============================================================

# --- Maquinas (una por capa)
HOST_CAPA_CONSUMIDORES=127.0.0.1
HOST_CAPA_SERVICIOS=127.0.0.1
HOST_CAPA_PERSISTENCIA=127.0.0.1

# --- Puertos del Gestor de Transacciones (maquina de servicios)
GT_PUERTO_CLIENTES=5555
GT_PUERTO_RMC=5556
GT_PUERTO_CANCELACION=5557

# --- Servicio de Persistencia (maquina de persistencia)
SP_PUERTO=5558
BD_RUTA=datos/srb.db

# --- Tiempo maximo de espera de una respuesta, en milisegundos
TIMEOUT_MS=5000

# HOST_CAPA_CONSUMIDORES=localhost
# HOST_CAPA_NEGOCIO=localhost
# HOST_CAPA_PERSISTENCIA=localhost

# GT_PUERTO_CLIENTES=5555
# GT_PUERTO_RMC=5556
# GT_PUERTO_CANCELACION=5557

# PERSISTENCIA=5558
