# Configuracion del SRB. El mismo archivo va en las tres maquinas.
# Con 127.0.0.1 todo corre en un solo computador; para el despliegue se escribe la IP de cada maquina.

# --- Maquinas (una por capa)
HOST_CAPA_CONSUMIDORES=127.0.0.1
HOST_CAPA_SERVICIOS=127.0.0.1
HOST_CAPA_PERSISTENCIA=127.0.0.1

# --- Puertos del Gestor de Transacciones (maquina de servicios)
GT_PUERTO_CLIENTES=5555
GT_PUERTO_RMC=5556
GT_PUERTO_CANCELACION=5557

# --- Servicio de Persistencia (maquina de persistencia)
SP_PUERTO=5558
# Replica de lectura del Servicio de Persistencia (arquitectura escalable)
SP_PUERTO_LECTURA=5559
# La base de datos va en el disco local de la maquina de persistencia: la carpeta del
# proyecto esta compartida por NFS y SQLite no funciona bien en un disco de red.
BD_RUTA=/var/tmp/srb/srb.db

# --- Clientes: cada uno recibe sus notificaciones en el puerto base + su id
PUERTO_BASE_NOTIFICACIONES=6000

# --- Tiempo maximo de espera de una respuesta, en milisegundos
TIMEOUT_MS=5000
