@startuml
!include _estilo.puml
title Diagrama de secuencia - Operaciones síncronas (consulta, reserva y modificación)

participant Cliente as C
participant "Gestor de\nTransacciones" as GT
participant "RMC\n(una réplica)" as RMC
participant "Réplica\nde lectura" as RL
participant "Persistencia\nprincipal" as SP
database SQLite as BD

== Consulta de los eventos de un mes ==
C -> GT : CONSULTA {mes} (REQ)
GT -> RMC : CONSULTA (DEALER)
RMC -> RL : CONSULTA (REQ)
RL -> BD : SELECT ocurrencias del mes
BD --> RL : filas
RL --> RMC : EXITO {eventos}
RMC --> GT : EXITO {eventos}
GT --> C : EXITO {eventos} (REP)

== Reserva de asientos ==
C -> GT : RESERVA {evento, fecha, n} (REQ)
GT -> GT : revisar el mensaje\ny guardar como pendiente
GT -> RMC : RESERVA
RMC -> RL : CONSULTA_DISPONIBILIDAD
RL --> RMC : EXITO {libres}
alt hay asientos suficientes
  RMC -> SP : AGREGAR_RESERVA (mismo uuid)
  SP -> BD : una transacción:\nUPDATE ocupados (solo si caben)\nINSERT reserva, INSERT operacion
  BD --> SP : commit
  SP --> RMC : EXITO {id_reserva}
else no alcanzan
  RMC -> RMC : FALLO SIN_CUPO
end
RMC --> GT : EXITO o FALLO
GT -> GT : registrar la métrica
GT --> C : EXITO o FALLO (REP)

== Modificación (número de asientos o fecha) ==
C -> GT : MODIFICACION {id_reserva, n o fecha} (REQ)
GT -> RMC : MODIFICACION
RMC -> RL : CONSULTAR_RESERVA
RL --> RMC : EXITO {evento, fecha, n actual}
RMC -> RL : CONSULTA_DISPONIBILIDAD\n(nueva fecha o misma ocurrencia)
RL --> RMC : EXITO {libres}
alt hay cupo
  RMC -> SP : MODIFICAR_RESERVA (mismo uuid)
  SP -> BD : una transacción:\nliberar en la ocurrencia actual,\nocupar en la nueva, UPDATE reserva
  BD --> SP : commit, o rollback si no caben
  SP --> RMC : EXITO, o FALLO sin cambiar nada
else no hay cupo o la fecha no existe
  RMC -> RMC : FALLO (la reserva queda como estaba)
end
RMC --> GT : EXITO o FALLO
GT --> C : EXITO o FALLO (REP)
@enduml
