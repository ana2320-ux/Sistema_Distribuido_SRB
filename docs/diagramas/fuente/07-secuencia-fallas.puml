@startuml
!include _estilo.puml
title Diagrama de secuencia - Tolerancia a fallas del RMC y del Gestor de Transacciones

participant Cliente as C
participant "Gestor de\nTransacciones\nactivo" as GT
participant "Gestor de\nTransacciones\nde respaldo" as GT2
participant "RMC 1" as R1
participant "RMC 2" as R2
participant "Persistencia\nprincipal" as SP

== Cae un RMC a mitad de una reserva ==
C -> GT : RESERVA (uuid X)
GT -> R1 : RESERVA (uuid X)
R1 -> SP : AGREGAR_RESERVA (uuid X)
SP --> R1 : EXITO {reserva 7}
destroy R1
note over R1 : se cae antes\nde responder
GT -> GT : 2 s sin respuesta
GT -> R2 : RESERVA (uuid X, reintento)
R2 -> SP : AGREGAR_RESERVA (uuid X)
SP -> SP : uuid X ya aplicado:\nno se repite
SP --> R2 : EXITO {reserva 7}
R2 --> GT : EXITO {reserva 7}
GT --> C : EXITO {reserva 7}

== Cae el Gestor de Transacciones activo ==
GT2 -> GT2 : cada segundo intenta\ntomar los puertos:\nocupados, sigue en espera
C -> GT : RESERVA (uuid Y)
destroy GT
note over GT : se cae con la\npetición en camino
GT2 -> GT2 : los puertos quedaron libres:\ntoma el control
R2 -> GT2 : se reconecta (ZeroMQ)
C -> C : 5 s sin respuesta
C -> GT2 : RESERVA (uuid Y, reintento)
GT2 -> R2 : RESERVA (uuid Y, reintento)
R2 -> SP : AGREGAR_RESERVA (uuid Y)
SP --> R2 : EXITO (se aplica una sola vez)
R2 --> GT2 : EXITO
GT2 --> C : EXITO
@enduml
