@startuml
!include _estilo.puml
title Modelo de datos (SQLite)
hide circle
hide methods
left to right direction

entity evento {
  * id : TEXT <<PK>>
  --
  * nombre : TEXT
  * tipo_evento : TEXT
}
entity ocurrencia {
  * id : INTEGER <<PK>>
  --
  * evento_id : TEXT <<FK>>
  * fecha : TEXT (AAAA/MM/DD)
  * capacidad : INTEGER = 100
  * puestos_ocupados : INTEGER
  --
  UNIQUE (evento_id, fecha)
  CHECK 0 <= puestos_ocupados <= capacidad
}
entity reserva {
  * id : INTEGER <<PK>>
  --
  * id_cliente : INTEGER
  * ocurrencia_id : INTEGER <<FK>>
  * numero_puestos : INTEGER > 0
  * activa : INTEGER (1 vigente, 0 cancelada)
}
entity operacion {
  * uuid : TEXT <<PK>>
  --
  * tipo : TEXT
  * datos : TEXT (JSON del resultado)
}

evento ||--|{ ocurrencia : "1 o 2 en el mes"
ocurrencia ||--o{ reserva
note bottom of operacion
  Una fila por cada escritura aplicada
  (reserva, modificación o liberación).
  Si la misma petición llega otra vez,
  se devuelve este resultado.
end note
@enduml
